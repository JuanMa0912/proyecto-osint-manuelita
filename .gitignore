# ============================================================
# .gitignore — Proyecto OSINT Manuelita
# ============================================================

# ----- Entorno y credenciales -----
.env
*.env.local
.env.*
!.env.example

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
dist/
build/
.eggs/

# ----- PDFs descargados (binarios grandes) -----
data_raw/pdfs/*.pdf

# ----- Datos crudos generados (reproducibles con el pipeline) -----
data_raw/web/*.html
data_raw/web/*.json

# ----- JSONs grandes procesados -----
data_processed/json/pdf_*.json
data_processed/json/normalized_manuelita_pdf_*.json
data_processed/json/normalized_manuelita_youtube_*.json
data_processed/json/youtube_canal_manuelita.json
data_processed/json/normalized_doc_*.json

# MANTENER en el repo:
# data_processed/json/normalized_manuelita_web_*.json
# data_processed/json/normalized_manuelita_social_*.json
# data_processed/json/news_index.json

# ----- Logs de ejecucion -----
logs/*.log
logs/**/*.log

# ----- Herramientas de desarrollo -----
# Ignora la config local de Claude pero versiona las reglas de interacción.
.claude/*
!.claude/rules.md
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Archivos temporales y de prueba (borrar del disco tambien) -----
demo_output_generator.py
hello.py
*.tmp
*.bak

# ----- Jupyter -----
.ipynb_checkpoints/
*.ipynb
# Excepcion: el notebook del bonus t-SNE/UMAP 3D SI es entregable (se versiona)
!reports/modulo3/tsne_3d_manuelita.ipynb

# ----- Tests y coverage -----
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ============================================================
# MODULO 2 — Indices vectoriales ChromaDB
# ============================================================
# Son binarios grandes (~10MB) que se regeneran con --reindex
# No tiene sentido versionar archivos SQLite binarios
data/vectorstore/
data/chroma/
**/*.sqlite3

# ============================================================
# REPORTS — solo artefactos generados automaticamente
# ============================================================
# Archivos de sesion y exploracion (obsoletos)
reports/session_*.json
reports/sources_map_*.json

# Resultados de tests — se regeneran ejecutando los scripts
# PowerShell: uv run python scripts/test_rag_bloque1.py
reports/resultados_rag_*.json
reports/resultados_rag_*.txt
reports/resultados_20_preguntas_*.json
reports/resultados_20_preguntas_*.txt

# MANTENER en el repo (entregables academicos):
# reports/informe_modulo1_qa_manuelita.pdf
# reports/informe_modulo1_qa_manuelita.docx
# reports/informe_modulo1_qa_manuelita.tex
# reports/informe_tecnico_proyecto_ia_agroindustrial.md
# reports/fase1_mapa_fuentes.md

# Notas internas del equipo (privado, no subir). Patron sin slash → ignora en cualquier carpeta (raiz o docs/).
NOTAS_INTERNAS_M3.md

# t-SNE (M3): carpeta de trabajo con copia del openfang.db (no versionar binarios del OS).
# El entregable SI se versiona: scripts/tsne_sesiones_m3.py, reports/modulo3/tsne_*
reports/modulo3/_work/

# Salidas de tests/resultados (no se versionan)
reports/resultados_*.json
reports/resultados_*.txt
reports/*_borrador.md
